---
import { cn } from '@/lib/utils';

interface Props {
  class?: string;
  title?: string;
}

const { class: className, title } = Astro.props;
---

<span
  title={title}
  class={cn(
    'inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium whitespace-nowrap',
    className,
  )}
>
  <slot />
</span>

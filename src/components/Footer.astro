---
import { REPO_URL, withBase } from '@/lib/site';
---

<footer class="border-t bg-muted/40">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-6 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <p>
      Deadlines change without notice. Always confirm against the official call for papers.
    </p>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
      <a class="hover:text-foreground" href={withBase('/subscribe')}>Calendar feeds</a>
      <a class="hover:text-foreground" href={`${REPO_URL}/blob/main/CONTRIBUTING.md`}>Add a conference</a>
      <a class="hover:text-foreground" href={REPO_URL}>Source</a>
    </div>
  </div>
</footer>

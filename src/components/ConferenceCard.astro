---
import { CalendarDays, ExternalLink, MapPin } from '@lucide/astro';

import Badge from '@/components/Badge.astro';
import Countdown from '@/components/Countdown.astro';
import type { ConferenceEdition } from '@/lib/conferences';
import {
  deadlineZoneLabel,
  filterAttributes,
  locationLabel,
  UNSTATED_TIMEZONE_NOTE,
} from '@/lib/conferences';
import { withBase } from '@/lib/site';
import { getTag, tagLabel } from '@/lib/taxonomy';
import { formatInZone } from '@/lib/time';
import { describeAge, editionVerification } from '@/lib/verification';

interface Props {
  edition: ConferenceEdition;
}

const { edition } = Astro.props;

const isEvent = edition.kind === 'event';
const now = new Date();
const upcoming = edition.nextDeadline ?? edition.nextAnyDeadline;

// Many events have nothing to submit, or only a poster deadline that has gone,
// so once no deadline is ahead their card counts down to the event itself.
const startsIn =
  isEvent && !upcoming && edition.start && edition.start.getTime() > now.getTime()
    ? edition.start
    : null;
const headline = startsIn ? null : (upcoming ?? edition.deadlines[0] ?? null);
const eventEnded = (edition.end ?? edition.start ?? now).getTime() < now.getTime();
const eventNote = !edition.start ? 'Dates not announced' : eventEnded ? 'Took place' : 'Under way';

// Shown only when it has gone stale: a freshness note on every card would be
// noise, but a card nobody has re-checked in months is worth flagging.
const verification = editionVerification(edition);
---

<article
  data-conference-card
  {...filterAttributes(edition)}
  class="group rounded-lg border bg-card p-4 shadow-sm transition-shadow hover:shadow-md"
>
  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
    <div class="min-w-0">
      <h2 class="flex flex-wrap items-baseline gap-x-2 text-lg leading-tight font-semibold">
        <a
          href={withBase(`/conference/${edition.id}`)}
          class="hover:text-primary hover:underline"
        >
          {edition.name} {edition.year}
        </a>
        {isEvent && <Badge class="border bg-transparent text-muted-foreground">Event</Badge>}
        {
          edition.cancelled && (
            <Badge class="bg-urgent/15 text-urgent">Cancelled</Badge>
          )
        }
      </h2>
      <p class="mt-0.5 truncate text-sm text-muted-foreground" title={edition.fullName}>
        {edition.fullName}
      </p>
    </div>

    <!-- Once this wraps under the title on a narrow screen, right-aligned text
         reads as a stray indent, so it only right-aligns once it sits beside it. -->
    <div class="text-left sm:text-right">
      {
        headline ? (
          <>
            <Countdown target={headline.utc} class="text-base" />
            <p class="mt-0.5 text-xs text-muted-foreground">{headline.label}</p>
          </>
        ) : startsIn ? (
          <>
            <Countdown target={startsIn} class="text-base" />
            <p class="mt-0.5 text-xs text-muted-foreground">Until the event starts</p>
          </>
        ) : (
          <p class="text-sm text-muted-foreground">
            {isEvent ? eventNote : 'No deadlines listed'}
          </p>
        )
      }
    </div>
  </div>

  <dl class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-1.5 text-sm text-muted-foreground">
    <div class="flex items-center gap-1.5">
      <dt class="sr-only">Location</dt>
      <MapPin class="size-3.5 shrink-0" aria-hidden="true" />
      <dd>{locationLabel(edition)}</dd>
    </div>
    <div class="flex items-center gap-1.5">
      <dt class="sr-only">{isEvent ? 'Event dates' : 'Conference dates'}</dt>
      <CalendarDays class="size-3.5 shrink-0" aria-hidden="true" />
      <dd>{edition.dateLabel}</dd>
    </div>
    {
      headline?.utc && (
        <div class="flex items-center gap-1.5">
          <dt class="sr-only">Deadline</dt>
          <dd>
            {formatInZone(headline.utc, headline.timezone)}{' '}
            <span
              class="opacity-70"
              title={headline.timezoneStated ? undefined : UNSTATED_TIMEZONE_NOTE}
            >
              {deadlineZoneLabel(headline)}
            </span>
          </dd>
        </div>
      )
    }
  </dl>

  <div class="mt-3 flex flex-wrap items-center gap-1.5">
    {
      edition.tags.map((tag) => (
        <Badge class={getTag(tag)?.className} title={getTag(tag)?.description}>
          {tagLabel(tag)}
        </Badge>
      ))
    }
    {
      edition.society.map((society) => (
        <Badge class="border bg-transparent text-muted-foreground">{society}</Badge>
      ))
    }
    {
      verification.stale && (
        <Badge
          class="border border-dashed bg-transparent text-muted-foreground"
          title={`Last checked against the official site ${describeAge(verification.ageDays)}.`}
        >
          Unverified for {describeAge(verification.ageDays).replace(' ago', '')}
        </Badge>
      )
    }

    <a
      href={edition.link}
      rel="noopener"
      class="ml-auto inline-flex min-h-6 items-center gap-1 text-xs text-muted-foreground transition-colors hover:text-primary"
    >
      {isEvent ? 'Website' : 'Call for papers'}
      <ExternalLink class="size-3" aria-hidden="true" />
    </a>
  </div>
</article>

---
/**
 * Where a year's conferences are held, on a world map.
 *
 * Shared by /map and /map/<year>, like YearCalendar. The SVG is complete when
 * it leaves the server: land, borders and markers are all projected at build
 * time, and every marker is a link, so the map works with JavaScript off. The
 * one inline script only adds the popover, the zoom buttons and the legend
 * switches on top of that DOM.
 */
import { ChevronLeft, ChevronRight } from '@lucide/astro';

import type { ConferenceEdition } from '@/lib/conferences';
import {
  BORDERS_PATH,
  buildMapMarkers,
  LAND_PATH,
  MAP_VIEWS,
  mapEditions,
  mapLegend,
  viewBoxAttr,
  type MapMarker,
} from '@/lib/map';
import { withBase } from '@/lib/site';
import { cn } from '@/lib/utils';

interface Props {
  year: number;
  years: number[];
  editions: ConferenceEdition[];
}

const { year, years, editions } = Astro.props;

const markers = buildMapMarkers(editions, year);
const listed = mapEditions(editions, year);
const legend = mapLegend(markers);
const placedIds = new Set(markers.flatMap((m) => m.editions.map((e) => e.id)));
const unplacedCount = listed.filter((e) => !placedIds.has(e.id)).length;

const world = MAP_VIEWS[0]!;

const index = years.indexOf(year);
const previous = years[index - 1];
const next = years[index + 1];

function detailFor(marker: MapMarker) {
  return {
    place: marker.key,
    editions: marker.editions.map((edition) => ({
      name: edition.name,
      fullName: edition.fullName,
      when: edition.dateLabel,
      topic: edition.topic,
      // Resolved in map.ts, never `fill-${tag}`: the JIT has to see it literally.
      markerClass: edition.markerClass,
      href: withBase(`/conference/${edition.id}`),
    })),
  };
}

function labelFor(marker: MapMarker): string {
  return `${marker.key}: ${marker.editions.map((e) => `${e.name}, ${e.dateLabel}`).join('; ')}`;
}
---

<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
  <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Where conferences meet</h1>
  <p class="text-sm text-muted-foreground">
    {listed.length} conference{listed.length === 1 ? '' : 's'} in {year}, coloured by main topic.
  </p>
</div>

<nav class="mt-6 flex items-center justify-center gap-1" aria-label="Year">
  {
    previous ? (
      <a
        class="inline-flex size-8 shrink-0 items-center justify-center rounded-md border transition-colors hover:bg-accent"
        href={withBase(`/map/${previous}`)}
        aria-label={`Go to ${previous}`}
      >
        <ChevronLeft class="size-4" aria-hidden="true" />
      </a>
    ) : (
      <span class="size-8 shrink-0" aria-hidden="true" />
    )
  }

  <div class="flex min-w-0 flex-wrap justify-center gap-1">
    {
      years.map((candidate) => (
        <a
          class={cn(
            'rounded-md px-3 py-1.5 text-sm font-semibold transition-colors',
            candidate === year
              ? 'bg-accent text-accent-foreground'
              : 'text-muted-foreground hover:text-foreground',
          )}
          href={withBase(`/map/${candidate}`)}
          aria-current={candidate === year ? 'page' : undefined}
        >
          {candidate}
        </a>
      ))
    }
  </div>

  {
    next ? (
      <a
        class="inline-flex size-8 shrink-0 items-center justify-center rounded-md border transition-colors hover:bg-accent"
        href={withBase(`/map/${next}`)}
        aria-label={`Go to ${next}`}
      >
        <ChevronRight class="size-4" aria-hidden="true" />
      </a>
    ) : (
      <span class="size-8 shrink-0" aria-hidden="true" />
    )
  }
</nav>

<section class="mt-6 min-w-0 rounded-lg border bg-card p-2 shadow-sm sm:p-3">
  <div class="mb-2 flex flex-wrap gap-1" role="group" aria-label="Zoom to region">
    {
      MAP_VIEWS.map((view) => (
        <button
          type="button"
          class="rounded-md px-2.5 py-1 text-xs font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none aria-pressed:bg-accent aria-pressed:text-accent-foreground"
          data-map-view={viewBoxAttr(view.box)}
          aria-pressed={view.id === 'world' ? 'true' : 'false'}
          hidden
        >
          {view.label}
        </button>
      ))
    }
  </div>

  <svg
    id="conference-map"
    viewBox={viewBoxAttr(world.box)}
    class="block h-auto w-full overflow-hidden rounded-md bg-sky-50/60 dark:bg-slate-900/60"
    role="group"
    aria-label={`World map of ${year} conference locations`}
  >
    <path d={LAND_PATH} class="fill-muted stroke-border" stroke-width="0.5" aria-hidden="true" />
    <path
      d={BORDERS_PATH}
      class="fill-none stroke-border"
      stroke-width="0.4"
      vector-effect="non-scaling-stroke"
      aria-hidden="true"
    />

    {
      markers.map((marker) => {
        const count = marker.editions.length;
        const only = count === 1 ? marker.editions[0]! : undefined;
        return (
          <a
            href={withBase(only ? `/conference/${only.id}` : `/map/${year}#list`)}
            class="cursor-pointer outline-none [&:focus-visible>circle]:stroke-ring"
            aria-label={labelFor(marker)}
            data-marker
            data-single={only ? '' : undefined}
            data-topics={JSON.stringify(marker.topics)}
            data-detail={JSON.stringify(detailFor(marker))}
            data-x={marker.x}
            data-y={marker.y}
          >
            <title>{labelFor(marker)}</title>
            <g transform={`translate(${marker.x} ${marker.y})`}>
            <circle
              r={count > 1 ? 7 : 5}
              class={cn(marker.markerClass, 'stroke-card')}
              stroke-width="1.5"
            />
            {count > 1 && (
              <text
                text-anchor="middle"
                dominant-baseline="central"
                class="pointer-events-none fill-white text-[8px] font-bold"
              >
                {count}
              </text>
            )}
            </g>
          </a>
        );
      })
    }
  </svg>

  <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1.5 px-1 text-xs text-muted-foreground">
    <span class="font-medium text-foreground">Main topic</span>
    {
      legend.map((entry) => (
        <button
          type="button"
          class="flex min-h-6 items-center gap-1.5 rounded-md px-1.5 py-0.5 transition-opacity hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none aria-[pressed=false]:opacity-40"
          data-toggle-topic={entry.topic}
          aria-pressed="true"
        >
          <svg class="size-2.5" viewBox="0 0 10 10" aria-hidden="true">
            <circle cx="5" cy="5" r="5" class={entry.markerClass} />
          </svg>
          {entry.topic}
        </button>
      ))
    }
    <span class="flex items-center gap-1.5 px-1.5">
      <svg class="size-3.5" viewBox="0 0 14 14" aria-hidden="true">
        <circle cx="7" cy="7" r="7" class="fill-slate-500 dark:fill-slate-400" />
        <text
          x="7"
          y="7"
          text-anchor="middle"
          dominant-baseline="central"
          class="fill-white text-[8px] font-bold">2</text
        >
      </svg>
      Several in one city
    </span>
  </div>
</section>

<section id="list" class="mt-8 scroll-mt-24">
  <h2 class="text-lg font-semibold tracking-tight">All {year} conferences</h2>
  {
    unplacedCount > 0 && (
      <p class="mt-1 text-sm text-muted-foreground">
        {unplacedCount} {unplacedCount === 1 ? 'is' : 'are'} online or {unplacedCount === 1 ? 'has' : 'have'} no
        city announced yet, so {unplacedCount === 1 ? 'it is' : 'they are'} listed here but not on the map.
      </p>
    )
  }
  <ul class="mt-3 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
    {
      listed.map((edition) => (
        <li class="min-w-0" data-list-topic={edition.topic}>
          <a
            href={withBase(`/conference/${edition.id}`)}
            class="-mx-2 flex flex-wrap items-baseline gap-x-2 rounded-md px-2 py-1 hover:bg-accent"
          >
            <svg class="size-2 shrink-0 self-center" viewBox="0 0 10 10" aria-hidden="true">
              <circle cx="5" cy="5" r="5" class={edition.markerClass} />
            </svg>
            <span class="shrink-0 font-medium">{edition.name}</span>
            <span class="text-muted-foreground">
              {edition.dateLabel} &middot; {edition.location}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<div
  id="map-popover"
  role="dialog"
  aria-label="Conference detail"
  hidden
  class="absolute z-50 w-64 rounded-lg border bg-card p-3 text-sm shadow-lg"
>
</div>

<script>
  // One script for the whole map, like the calendar's: a delegated popover,
  // the zoom buttons and the legend switches, all acting on the SVG the server
  // already rendered. Nothing here draws a marker.
  const svg = document.getElementById('conference-map') as SVGSVGElement | null;
  const popover = document.getElementById('map-popover');

  if (svg && popover) {
    const markers = [...svg.querySelectorAll<SVGAElement>('[data-marker]')];
    const viewButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-map-view]')];
    const hiddenTopics = new Set<string>();
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let pinned = false;
    let overPopover = false;
    let hideTimer: number | undefined;

    const escape = (value: string) => value.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
    const detailOf = (el: Element) => JSON.parse((el as HTMLElement).dataset.detail ?? '{}');
    const parseBox = (value: string) => value.split(' ').map(Number);
    const markerFrom = (target: EventTarget | null) =>
      (target as Element | null)?.closest?.<SVGAElement>('[data-marker]') ?? null;

    // --- zoom -------------------------------------------------------------
    // Markers are drawn in map units, so on their own they would shrink on a
    // phone and swell when zooming in. Scaling them by map units per screen
    // pixel keeps every marker the same size on screen, whatever the view.
    const placeMarkers = () => {
      const box = parseBox(svg.getAttribute('viewBox') ?? '');
      const scale = (box[2]! / Math.max(1, svg.clientWidth)).toFixed(3);
      for (const marker of markers) {
        marker.querySelector('g')?.setAttribute(
          'transform',
          `translate(${marker.dataset.x} ${marker.dataset.y}) scale(${scale})`,
        );
      }
    };

    const zoomTo = (target: number[]) => {
      const from = parseBox(svg.getAttribute('viewBox') ?? '');
      const duration = reduceMotion ? 0 : 350;
      const started = performance.now();

      const step = (now: number) => {
        const t = duration === 0 ? 1 : Math.min(1, (now - started) / duration);
        const eased = 1 - (1 - t) ** 3;
        const box = from.map((v, i) => v + (target[i]! - v) * eased);
        svg.setAttribute('viewBox', box.map((v) => v.toFixed(1)).join(' '));
        placeMarkers();
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    for (const button of viewButtons) {
      button.hidden = false;
      button.addEventListener('click', () => {
        for (const other of viewButtons) other.setAttribute('aria-pressed', String(other === button));
        popover.hidden = true;
        pinned = false;
        zoomTo(parseBox(button.dataset.mapView!));
      });
    }

    new ResizeObserver(placeMarkers).observe(svg);

    // --- popover ----------------------------------------------------------
    const shown = (detail: any) =>
      (detail.editions ?? []).filter((e: any) => !hiddenTopics.has(e.topic));

    const render = (marker: SVGAElement) => {
      const detail = detailOf(marker);
      const editions = shown(detail);
      if (editions.length === 0) {
        popover.hidden = true;
        return;
      }

      const rows = [`<p class="font-semibold">${escape(detail.place)}</p>`];
      for (const edition of editions) {
        rows.push(
          `<a class="mt-2 block rounded-md p-1.5 -mx-1.5 hover:bg-accent" href="${escape(edition.href)}">` +
            `<span class="flex items-center gap-1.5"><svg class="size-2 shrink-0" viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="5" class="${escape(edition.markerClass)}"/></svg>` +
            `<span class="font-medium">${escape(edition.name)}</span></span>` +
            `<span class="block pl-3.5 text-muted-foreground">${escape(edition.fullName)}</span>` +
            `<span class="block pl-3.5 text-muted-foreground">${escape(edition.when)} &middot; ${escape(edition.topic)}</span></a>`,
        );
      }
      popover.innerHTML = rows.join('');

      const rect = marker.getBoundingClientRect();
      popover.hidden = false;
      const width = popover.offsetWidth;
      const left = Math.min(
        Math.max(8, rect.left + window.scrollX + rect.width / 2 - width / 2),
        window.scrollX + document.documentElement.clientWidth - width - 8,
      );
      popover.style.left = `${left}px`;
      popover.style.top = `${rect.bottom + window.scrollY + 6}px`;
    };

    const hide = () => {
      if (pinned || overPopover) return;
      popover.hidden = true;
    };

    svg.addEventListener('mouseover', (event) => {
      const marker = markerFrom(event.target);
      if (!marker || pinned) return;
      window.clearTimeout(hideTimer);
      render(marker);
    });

    svg.addEventListener('mouseout', (event) => {
      if (!markerFrom(event.target)) return;
      hideTimer = window.setTimeout(hide, 150);
    });

    svg.addEventListener('focusin', (event) => {
      const marker = markerFrom(event.target);
      if (marker) render(marker);
    });

    popover.addEventListener('mouseenter', () => {
      overPopover = true;
      window.clearTimeout(hideTimer);
    });
    popover.addEventListener('mouseleave', () => {
      overPopover = false;
      hideTimer = window.setTimeout(hide, 150);
    });

    // A tap on touch, where there is no hover, opens the popover instead of
    // following the link; the popover's own links then go to the conference.
    svg.addEventListener('click', (event) => {
      const marker = markerFrom(event.target);
      if (!marker) return;
      const touch = (event as PointerEvent).pointerType === 'touch';
      if (!touch && marker.dataset.single !== undefined) return;
      event.preventDefault();
      pinned = true;
      render(marker);
    });

    document.addEventListener('click', (event) => {
      if (!pinned) return;
      const target = event.target as Node;
      if (popover.contains(target) || markerFrom(target)) return;
      pinned = false;
      popover.hidden = true;
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      pinned = false;
      popover.hidden = true;
    });

    // --- legend switches --------------------------------------------------
    for (const toggle of document.querySelectorAll<HTMLButtonElement>('[data-toggle-topic]')) {
      toggle.addEventListener('click', () => {
        const topic = toggle.dataset.toggleTopic!;
        const on = !hiddenTopics.has(topic);
        if (on) hiddenTopics.add(topic);
        else hiddenTopics.delete(topic);
        toggle.setAttribute('aria-pressed', String(!on));

        for (const marker of markers) {
          const topics: string[] = JSON.parse(marker.dataset.topics ?? '[]');
          const hidden = topics.every((t) => hiddenTopics.has(t));
          marker.style.display = hidden ? 'none' : '';
          if (hidden) marker.setAttribute('tabindex', '-1');
          else marker.removeAttribute('tabindex');
        }
        for (const item of document.querySelectorAll<HTMLElement>('[data-list-topic]')) {
          item.hidden = hiddenTopics.has(item.dataset.listTopic ?? '');
        }
        popover.hidden = true;
        pinned = false;
      });
    }
  }
</script>

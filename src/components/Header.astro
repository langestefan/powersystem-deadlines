---
import { CalendarPlus } from '@lucide/astro';
import GitHubIcon from '@/components/GitHubIcon.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { REPO_URL, SITE_TITLE, withBase } from '@/lib/site';

interface Props {
  path: string;
}

const { path } = Astro.props;

const links = [
  { href: '/', label: 'Deadlines' },
  { href: '/events', label: 'Events' },
  { href: '/overview', label: 'Calendar' },
  { href: '/map', label: 'Map' },
  { href: '/past', label: 'Archive' },
  { href: '/changelog', label: 'Changes' },
  { href: '/about', label: 'About' },
];

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!--
  Subscribe is the primary button among the controls, not a nav link, so it
  is shown at every width: icon-only on a phone, labelled from `sm`. The
  brand, seven links and the controls need about 985px on one row, so they only
  share a row from `lg`:
  below it the nav wraps onto a row of its own (`w-full` plus flex-wrap) and
  scrolls sideways if even that is not enough. Ordering keeps the source in
  reading order while putting the controls at the right-hand end of both
  layouts, so the list is written once rather than once per breakpoint.
-->
<header class="sticky top-0 z-40 border-b bg-background/85 backdrop-blur">
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-4 px-4 pt-3 pb-1.5 sm:px-6 lg:flex-nowrap lg:py-3"
  >
    <a
      href={withBase('/')}
      class="flex items-center gap-2 font-semibold tracking-tight whitespace-nowrap"
    >
      <span aria-hidden="true" class="text-lg">⚡</span>
      <span>{SITE_TITLE}</span>
    </a>

    <nav
      class="order-3 -mx-4 flex w-full items-center gap-1 overflow-x-auto px-4 pt-1.5 text-sm [scrollbar-width:none] sm:-mx-6 sm:px-6 lg:order-2 lg:mx-0 lg:ml-auto lg:w-auto lg:overflow-visible lg:px-0 lg:pt-0 [&::-webkit-scrollbar]:hidden"
      aria-label="Main"
    >
      {
        links.map((link) => (
          <a
            href={withBase(link.href)}
            class:list={[
              'shrink-0 rounded-md px-2.5 py-1.5 transition-colors hover:bg-accent hover:text-accent-foreground',
              isActive(link.href) ? 'bg-accent text-accent-foreground' : 'text-muted-foreground',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="order-2 ml-auto flex items-center gap-1 lg:order-3 lg:ml-0">
      <a
        href={withBase('/subscribe')}
        class="inline-flex items-center gap-1.5 rounded-md bg-primary p-2 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90 sm:px-3 sm:py-1.5"
        aria-label="Subscribe"
        aria-current={path.startsWith('/subscribe') ? 'page' : undefined}
      >
        <CalendarPlus class="size-4" aria-hidden="true" />
        <span class="hidden sm:inline">Subscribe</span>
      </a>
      <ThemeToggle />
      <a
        href={REPO_URL}
        class="rounded-md p-2 text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
        aria-label="Source on GitHub"
        rel="noopener"
      >
        <GitHubIcon />
      </a>
    </div>
  </div>
</header>

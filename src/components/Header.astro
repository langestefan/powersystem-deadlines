---
import { CalendarPlus } from '@lucide/astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { REPO_URL, SITE_TITLE, withBase } from '@/lib/site';

interface Props {
  path: string;
}

const { path } = Astro.props;

const links = [
  { href: '/', label: 'Deadlines' },
  { href: '/overview', label: 'Calendar' },
  { href: '/subscribe', label: 'Subscribe' },
  { href: '/past', label: 'Archive' },
  { href: '/about', label: 'About' },
];

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!--
  The brand, five links and the controls need about 690px, so they only share a
  row once there is room: below `md` the nav wraps onto a row of its own
  (`w-full` plus flex-wrap) and scrolls sideways if even that is not enough.
  The Subscribe button waits for `lg`, because until then it is 110px spent
  repeating the Subscribe link two centimetres to its left. Ordering keeps the
  source in reading order while putting the controls at the right-hand end of
  both layouts, so the list is written once rather than once per breakpoint.
-->
<header class="sticky top-0 z-40 border-b bg-background/85 backdrop-blur">
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-4 px-4 pt-3 pb-1.5 sm:px-6 md:flex-nowrap md:py-3"
  >
    <a
      href={withBase('/')}
      class="flex items-center gap-2 font-semibold tracking-tight whitespace-nowrap"
    >
      <span aria-hidden="true" class="text-lg">⚡</span>
      <span>{SITE_TITLE}</span>
    </a>

    <nav
      class="order-3 -mx-4 flex w-full items-center gap-1 overflow-x-auto px-4 pt-1.5 text-sm [scrollbar-width:none] sm:-mx-6 sm:px-6 md:order-2 md:mx-0 md:ml-auto md:w-auto md:overflow-visible md:px-0 md:pt-0 [&::-webkit-scrollbar]:hidden"
      aria-label="Main"
    >
      {
        links.map((link) => (
          <a
            href={withBase(link.href)}
            class:list={[
              'shrink-0 rounded-md px-2.5 py-1.5 transition-colors hover:bg-accent hover:text-accent-foreground',
              isActive(link.href) ? 'bg-accent text-accent-foreground' : 'text-muted-foreground',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="order-2 ml-auto flex items-center gap-1 md:order-3 md:ml-0">
      <a
        href={withBase('/subscribe')}
        class="hidden items-center gap-1.5 rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90 lg:inline-flex"
      >
        <CalendarPlus class="size-4" />
        Subscribe
      </a>
      <ThemeToggle />
      <a
        href={REPO_URL}
        class="rounded-md p-2 text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
        aria-label="Source on GitHub"
        rel="noopener"
      >
        {/* Lucide dropped brand marks, so the GitHub logo is inlined. */}
        <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          />
        </svg>
      </a>
    </div>
  </div>
</header>

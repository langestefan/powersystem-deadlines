---
import { Check } from '@lucide/astro';

import Countdown from '@/components/Countdown.astro';
import type { ConferenceEdition } from '@/lib/conferences';
import { googleCalendarUrl, outlookCalendarUrl } from '@/lib/addToCalendar';
import { conferenceFeedPath } from '@/lib/feeds';
import { withBase } from '@/lib/site';
import { formatInZone, timezoneLabel } from '@/lib/time';

interface Props {
  edition: ConferenceEdition;
}

const { edition } = Astro.props;
const now = Date.now();

const rows = edition.deadlines.map((deadline) => ({
  deadline,
  past: deadline.utc !== null && deadline.utc.getTime() <= now,
  google: googleCalendarUrl(edition, deadline),
  outlook: outlookCalendarUrl(edition, deadline),
}));

const linkClass =
  'rounded px-1.5 py-0.5 text-xs text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground';
---

{
  rows.length === 0 ? (
    <p class="text-sm text-muted-foreground">No deadlines listed yet.</p>
  ) : (
    <div class="overflow-x-auto">
      <table class="w-full min-w-[36rem] text-sm">
        <thead>
          <tr class="border-b text-left text-xs tracking-wide uppercase opacity-70">
            <th scope="col" class="py-2 pr-4 font-semibold">Milestone</th>
            <th scope="col" class="py-2 pr-4 font-semibold">Date</th>
            <th scope="col" class="py-2 pr-4 font-semibold">Countdown</th>
            <th scope="col" class="py-2 font-semibold">Add to</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(({ deadline, past, google, outlook }) => (
            <tr class:list={['border-b last:border-0', past && 'opacity-55']}>
              <td class="py-2.5 pr-4">
                <span class="flex items-center gap-1.5">
                  {past && <Check class="size-3.5 shrink-0" aria-label="Passed" />}
                  {deadline.label}
                </span>
              </td>
              <td class="py-2.5 pr-4 whitespace-nowrap">
                {deadline.utc ? (
                  <>
                    {formatInZone(deadline.utc, deadline.timezone)}{' '}
                    <span class="text-xs opacity-70">{timezoneLabel(deadline.timezone)}</span>
                  </>
                ) : (
                  <span class="text-muted-foreground">To be announced</span>
                )}
              </td>
              <td class="py-2.5 pr-4">
                <Countdown target={deadline.utc} />
              </td>
              <td class="py-2.5">
                {google && outlook ? (
                  <span class="flex flex-wrap gap-0.5">
                    <a class={linkClass} href={google} rel="noopener">
                      Google
                    </a>
                    <a class={linkClass} href={outlook} rel="noopener">
                      Outlook
                    </a>
                    <a class={linkClass} href={withBase(conferenceFeedPath(edition.id))}>
                      .ics
                    </a>
                  </span>
                ) : (
                  <span class="px-1.5 text-xs text-muted-foreground">—</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}

---
/**
 * A year of deadlines and conference dates as twelve mini-months.
 *
 * Shared by /overview and /overview/<year> so the entry point can render the
 * real thing rather than bouncing through a redirect. GitHub Pages has no
 * server-side redirects, so Astro can only emit a meta-refresh page, which is
 * a dead end for anyone who has those disabled.
 */
import { ChevronLeft, ChevronRight } from '@lucide/astro';

import type { ConferenceEdition } from '@/lib/conferences';
import { buildYearOverview, hasMarks, WEEKDAY_LABELS, type OverviewDay } from '@/lib/overview';
import { withBase } from '@/lib/site';
import { cn } from '@/lib/utils';

interface Props {
  year: number;
  years: number[];
  editions: ConferenceEdition[];
}

const { year, years, editions } = Astro.props;

const months = buildYearOverview(editions, year, new Date());

// Legend explains only what this year actually shows, so it is read off the
// rendered cells rather than the whole dataset. Two types that mean the same
// thing to an author share a label, so each label appears once.
const shown = months.flatMap((month) => month.weeks.flat()).filter((day) => day.inMonth);

const deadlineLegend = [
  ...new Map(
    shown.flatMap((day) => day.deadlines).map((d) => [d.typeLabel, d.dotClass]),
  ),
].map(([label, dotClass]) => ({ label, dotClass }));

const topicLegend = [
  ...new Map(shown.flatMap((day) => day.events).map((e) => [e.topic, e.barClass])),
].map(([topic, barClass]) => ({ topic, barClass }));
const index = years.indexOf(year);
const previous = years[index - 1];
const next = years[index + 1];

/** Everything the popover needs, and the no-JS label, in one place. */
function detailFor(day: OverviewDay) {
  return {
    date: new Intl.DateTimeFormat('en-GB', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(`${day.date}T00:00:00Z`)),
    deadlines: day.deadlines.map((deadline) => ({
      name: deadline.editionName,
      label: deadline.label,
      when: `${deadline.time} ${deadline.timezone}`,
      href: withBase(`/conference/${deadline.editionId}`),
      typeLabel: deadline.typeLabel,
      // Already resolved by overview.ts, never `bg-${type}`: the JIT compiler
      // has to see these strings literally.
      dotClass: deadline.dotClass,
    })),
    events: day.events.map((event) => ({
      name: event.editionName,
      // The whole run, not just this day: hovering one day of a conference
      // should tell you when the rest of it is.
      when: event.dateLabel,
      location: event.location,
      topic: event.topic,
      href: withBase(`/conference/${event.editionId}`),
    })),
  };
}

function summaryFor(day: OverviewDay): string {
  const parts = [
    ...day.deadlines.map((d) => `${d.editionName}: ${d.label}`),
    ...day.events.map((e) => `${e.editionName} runs`),
  ];
  return parts.join('; ');
}
---

  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">The year at a glance</h1>
    <p class="text-sm text-muted-foreground">
      Deadlines and conference dates across {year}.
    </p>
  </div>

  <nav class="mt-6 flex items-center justify-center gap-1" aria-label="Year">
    {
      previous ? (
        <a
          class="inline-flex size-8 items-center justify-center rounded-md border transition-colors hover:bg-accent"
          href={withBase(`/overview/${previous}`)}
          aria-label={`Go to ${previous}`}
        >
          <ChevronLeft class="size-4" aria-hidden="true" />
        </a>
      ) : (
        <span class="size-8" aria-hidden="true" />
      )
    }

    {
      years.map((candidate) => (
        <a
          class={cn(
            'rounded-md px-3 py-1.5 text-sm font-semibold transition-colors',
            candidate === year
              ? 'bg-accent text-accent-foreground'
              : 'text-muted-foreground hover:text-foreground',
          )}
          href={withBase(`/overview/${candidate}`)}
          aria-current={candidate === year ? 'page' : undefined}
        >
          {candidate}
        </a>
      ))
    }

    {
      next ? (
        <a
          class="inline-flex size-8 items-center justify-center rounded-md border transition-colors hover:bg-accent"
          href={withBase(`/overview/${next}`)}
          aria-label={`Go to ${next}`}
        >
          <ChevronRight class="size-4" aria-hidden="true" />
        </a>
      ) : (
        <span class="size-8" aria-hidden="true" />
      )
    }
  </nav>

  <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {
      months.map((month) => (
        <section class="rounded-lg border bg-card p-3 shadow-sm">
          <h2 class="mb-2 text-center text-sm font-semibold">{month.label}</h2>

          <div class="grid grid-cols-7 text-center text-[11px]">
            {WEEKDAY_LABELS.map((weekday) => (
              <span class="pb-1 font-medium text-muted-foreground" aria-hidden="true">
                {weekday}
              </span>
            ))}

            {month.weeks.map((week) =>
              week.map((day, position) => {
                const marked = hasMarks(day);
                const Cell = marked ? 'button' : 'div';
                const event = day.events[0];
                const roundLeft = position === 0 || event?.isStart;
                const roundRight = position === 6 || event?.isEnd;

                return (
                  <Cell
                    class={cn(
                      'relative flex h-9 flex-col items-center justify-center',
                      !day.inMonth && 'opacity-0',
                      marked &&
                        'cursor-pointer rounded-sm focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none',
                    )}
                    type={marked ? 'button' : undefined}
                    aria-hidden={!day.inMonth ? 'true' : undefined}
                    aria-label={marked ? `${day.date}. ${summaryFor(day)}` : undefined}
                    data-day={marked ? day.date : undefined}
                    data-detail={marked ? JSON.stringify(detailFor(day)) : undefined}
                  >
                    {day.inMonth && day.events.length > 0 && (
                      <span
                        aria-hidden="true"
                        data-topic-mark={event?.topic}
                        class={cn(
                          'absolute inset-x-0 top-1 h-4',
                          event?.barClass ?? 'bg-primary/15',
                          roundLeft && 'ml-0.5 rounded-l-full',
                          roundRight && 'mr-0.5 rounded-r-full',
                        )}
                      />
                    )}

                    <span
                      class={cn(
                        'relative leading-none tabular-nums',
                        day.isToday &&
                          'flex size-5 items-center justify-center rounded-full bg-foreground font-semibold text-background',
                      )}
                    >
                      {day.dayOfMonth}
                    </span>

                    <span class="relative mt-1 flex h-2 items-center gap-1">
                      {day.inMonth &&
                        day.deadlines.slice(0, 3).map((deadline) => (
                          <span
                            aria-hidden="true"
                            data-deadline-mark={deadline.typeLabel}
                            class={cn('size-2 rounded-full ring-1 ring-card', deadline.dotClass)}
                          />
                        ))}
                    </span>
                  </Cell>
                );
              }),
            )}
          </div>
        </section>
      ))
    }
  </div>

  <div class="mt-6 space-y-2.5 text-xs text-muted-foreground">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <span class="font-medium text-foreground">Deadline</span>
      {
        deadlineLegend.map((entry) => (
          <button
            type="button"
            class="flex items-center gap-1.5 rounded-md px-1.5 py-0.5 transition-opacity hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none aria-[pressed=false]:opacity-40"
            data-toggle-deadline={entry.label}
            aria-pressed="true"
          >
            <span class={cn('size-2 rounded-full', entry.dotClass)} />
            {entry.label}
          </button>
        ))
      }
    </div>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <span class="font-medium text-foreground">Conference running</span>
      {
        topicLegend.map((entry) => (
          <button
            type="button"
            class="flex items-center gap-1.5 rounded-md px-1.5 py-0.5 transition-opacity hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none aria-[pressed=false]:opacity-40"
            data-toggle-topic={entry.topic}
            aria-pressed="true"
          >
            <span class={cn('h-2.5 w-5 rounded-full', entry.barClass)} />
            {entry.topic}
          </button>
        ))
      }
    </div>
  </div>

  <p class="mt-2 text-xs">
    <button
      type="button"
      id="show-all"
      class="rounded-md px-1.5 py-0.5 text-primary hover:underline focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
      hidden
    >
      Show all
    </button>
  </p>

  <div
    id="day-popover"
    role="dialog"
    aria-label="Day detail"
    hidden
    class="absolute z-50 w-64 rounded-lg border bg-card p-3 text-sm shadow-lg"
  >
  </div>

  <script>
    // One listener for the whole grid rather than an island per day, matching
    // the countdown ticker in BaseLayout. Hover opens the popover for mouse
    // users; focus and click do the same for keyboard and touch, where hover
    // does not exist. The legend doubles as a set of switches, filtering the
    // marks already in the DOM rather than re-rendering anything.
    const popover = document.getElementById('day-popover');
    const showAll = document.getElementById('show-all');

    if (popover) {
      let pinned = false;
      let hideTimer: number | undefined;
      let overPopover = false;

      const hiddenDeadlines = new Set<string>();
      const hiddenTopics = new Set<string>();

      const escape = (value: string) =>
        value.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);

      const detailOf = (cell: HTMLElement) => JSON.parse(cell.dataset.detail ?? '{}');
      const shownDeadlines = (d: any) =>
        (d.deadlines ?? []).filter((x: any) => !hiddenDeadlines.has(x.typeLabel));
      const shownEvents = (d: any) =>
        (d.events ?? []).filter((x: any) => !hiddenTopics.has(x.topic));

      const render = (cell: HTMLElement) => {
        const detail = detailOf(cell);
        const deadlines = shownDeadlines(detail);
        const events = shownEvents(detail);

        // Everything on this day is filtered out, so there is nothing to say.
        if (deadlines.length === 0 && events.length === 0) {
          popover.hidden = true;
          return;
        }

        const rows: string[] = [`<p class="font-semibold">${escape(detail.date)}</p>`];

        for (const deadline of deadlines) {
          rows.push(
            `<a class="mt-2 block rounded-md p-1.5 -mx-1.5 hover:bg-accent" href="${escape(deadline.href)}">` +
              `<span class="flex items-center gap-1.5"><span class="size-1.5 shrink-0 rounded-full ${escape(deadline.dotClass)}"></span>` +
              `<span class="font-medium">${escape(deadline.name)}</span></span>` +
              `<span class="block pl-3 text-muted-foreground">${escape(deadline.label)} &middot; ${escape(deadline.when)}</span></a>`,
          );
        }

        for (const event of events) {
          rows.push(
            `<a class="mt-2 block rounded-md p-1.5 -mx-1.5 hover:bg-accent" href="${escape(event.href)}">` +
              `<span class="font-medium">${escape(event.name)}</span>` +
              `<span class="block text-muted-foreground">${escape(event.when)}${event.location ? ` &middot; ${escape(event.location)}` : ''}</span></a>`,
          );
        }

        popover.innerHTML = rows.join('');

        const rect = cell.getBoundingClientRect();
        popover.hidden = false;
        const width = popover.offsetWidth;
        const left = Math.min(
          Math.max(8, rect.left + window.scrollX + rect.width / 2 - width / 2),
          window.scrollX + document.documentElement.clientWidth - width - 8,
        );
        popover.style.left = `${left}px`;
        popover.style.top = `${rect.bottom + window.scrollY + 6}px`;
      };

      const hide = () => {
        if (pinned || overPopover) return;
        popover.hidden = true;
      };

      const cellFrom = (target: EventTarget | null) =>
        (target as HTMLElement | null)?.closest<HTMLElement>('[data-detail]') ?? null;

      /** Reflect the switches onto the marks, the cells and the reset link. */
      const applyFilters = () => {
        for (const mark of document.querySelectorAll<HTMLElement>('[data-deadline-mark]')) {
          mark.hidden = hiddenDeadlines.has(mark.dataset.deadlineMark ?? '');
        }
        for (const mark of document.querySelectorAll<HTMLElement>('[data-topic-mark]')) {
          mark.hidden = hiddenTopics.has(mark.dataset.topicMark ?? '');
        }

        for (const cell of document.querySelectorAll<HTMLElement>('[data-detail]')) {
          const detail = detailOf(cell);
          const deadlines = shownDeadlines(detail);
          const events = shownEvents(detail);
          const empty = deadlines.length === 0 && events.length === 0;

          // A cell with nothing left to show must stop announcing it too.
          cell.toggleAttribute('data-muted', empty);
          cell.setAttribute(
            'aria-label',
            empty
              ? (cell.dataset.day ?? '')
              : `${cell.dataset.day}. ` +
                  [
                    ...deadlines.map((d: any) => `${d.name}: ${d.label}`),
                    ...events.map((e: any) => `${e.name} runs`),
                  ].join('; '),
          );
        }

        const filtering = hiddenDeadlines.size > 0 || hiddenTopics.size > 0;
        if (showAll) showAll.hidden = !filtering;
        popover.hidden = true;
        pinned = false;
      };

      document.addEventListener('mouseover', (event) => {
        const cell = cellFrom(event.target);
        if (!cell || pinned || cell.hasAttribute('data-muted')) return;
        window.clearTimeout(hideTimer);
        render(cell);
      });

      document.addEventListener('mouseout', (event) => {
        if (!cellFrom(event.target)) return;
        hideTimer = window.setTimeout(hide, 150);
      });

      popover.addEventListener('mouseenter', () => {
        overPopover = true;
        window.clearTimeout(hideTimer);
      });

      popover.addEventListener('mouseleave', () => {
        overPopover = false;
        hide();
      });

      document.addEventListener('focusin', (event) => {
        const cell = cellFrom(event.target);
        if (cell) {
          pinned = false;
          if (!cell.hasAttribute('data-muted')) render(cell);
        } else if (!popover.contains(event.target as Node)) {
          pinned = false;
          hide();
        }
      });

      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null;

        const toggle = target?.closest<HTMLElement>('[data-toggle-deadline], [data-toggle-topic]');
        if (toggle) {
          const deadlineLabel = toggle.dataset.toggleDeadline;
          const set = deadlineLabel === undefined ? hiddenTopics : hiddenDeadlines;
          const key = deadlineLabel ?? toggle.dataset.toggleTopic ?? '';

          if (set.has(key)) set.delete(key);
          else set.add(key);

          toggle.setAttribute('aria-pressed', String(!set.has(key)));
          applyFilters();
          return;
        }

        if (target?.closest('#show-all')) {
          hiddenDeadlines.clear();
          hiddenTopics.clear();
          for (const button of document.querySelectorAll('[data-toggle-deadline], [data-toggle-topic]')) {
            button.setAttribute('aria-pressed', 'true');
          }
          applyFilters();
          return;
        }

        const cell = cellFrom(event.target);
        if (cell) {
          if (cell.hasAttribute('data-muted')) return;
          pinned = true;
          render(cell);
          return;
        }
        if (popover.contains(event.target as Node)) return;
        pinned = false;
        hide();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        pinned = false;
        overPopover = false;
        hide();
      });
    }
  </script>

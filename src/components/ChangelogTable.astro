---
import { formatChangeDate, type ChangelogEntry } from '@/lib/changelog';
import { withBase } from '@/lib/site';

interface Props {
  entries: ChangelogEntry[];
  /** Off on a conference's own page, where every row would say the same thing. */
  showConference?: boolean;
}

const { entries, showConference = false } = Astro.props;
---

<!-- Five columns do not fit a phone, so the table scrolls inside its own box
     rather than widening the page. -->
<div class="overflow-x-auto">
  <table class="w-full text-left text-sm">
    <thead class="text-xs tracking-wide text-muted-foreground uppercase">
      <tr class="border-b">
        {showConference && <th scope="col" class="py-2 pr-4 font-semibold">Conference</th>}
        <th scope="col" class="py-2 pr-4 font-semibold whitespace-nowrap">Date changed</th>
        <th scope="col" class="py-2 pr-4 font-semibold">Field</th>
        <th scope="col" class="py-2 pr-4 font-semibold whitespace-nowrap">Old value</th>
        <th scope="col" class="py-2 font-semibold whitespace-nowrap">New value</th>
      </tr>
    </thead>
    <tbody class="divide-y">
      {
        entries.map((entry) => (
          <tr class="align-top">
            {showConference && (
              <td class="py-2 pr-4 whitespace-nowrap">
                <a
                  class="font-medium text-primary hover:underline"
                  href={withBase(`/conference/${entry.edition.id}`)}
                >
                  {entry.edition.name} {entry.edition.year}
                </a>
              </td>
            )}
            <td class="py-2 pr-4 whitespace-nowrap">
              <time datetime={entry.date.toISOString().slice(0, 10)}>
                {formatChangeDate(entry.date)}
              </time>
            </td>
            <td class="py-2 pr-4 font-mono text-xs leading-5 whitespace-nowrap">{entry.field}</td>
            <td class="min-w-28 py-2 pr-4 text-muted-foreground">{entry.old ?? '—'}</td>
            <td class="min-w-28 py-2">{entry.new ?? '—'}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

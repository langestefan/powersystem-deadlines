---
import ConferenceCard from '@/components/ConferenceCard.astro';
import FilterBar from '@/components/FilterBar.tsx';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  filterAttributes,
  filterOptions,
  getPastEditions,
  getUpcomingEditions,
  locationLabel,
  submissionStatus,
} from '@/lib/conferences';
import { withBase } from '@/lib/site';

// Events (research meetings and the like) have their own page, /events.
const editions = (await getUpcomingEditions()).filter((edition) => edition.kind === 'conference');

/**
 * Past editions, rendered hidden and revealed by FilterBar only when a search
 * matches them. Without this, a conference vanishes from search the day after
 * it ends, and the empty state then invites the reader to add it.
 */
const archived = (await getPastEditions()).filter((edition) => edition.kind === 'conference');

/**
 * Buckets shown as headings, in order. The last two are both "nothing to submit
 * today", but for opposite reasons: one call has not opened, the other has
 * shut. Lumping them together told a reader the wrong thing about each.
 */
const GROUPS = [
  { id: 'urgent', title: 'Next 7 days', blurb: undefined },
  { id: 'soon', title: 'Next 30 days', blurb: undefined },
  { id: 'later', title: 'Later', blurb: undefined },
  {
    id: 'unannounced',
    title: 'Dates not announced',
    blurb: 'The call for papers has not given these dates yet.',
  },
  {
    id: 'closed',
    title: 'Submissions closed',
    blurb: 'Every listed deadline has passed, but the conference is still ahead.',
  },
] as const;

const grouped = GROUPS.map((group) => ({
  ...group,
  editions: editions.filter((edition) => submissionStatus(edition) === group.id),
})).filter((group) => group.editions.length > 0);

/** Filter options, each with the number of listed conferences it would match. */
const options = filterOptions(editions);
---

<BaseLayout path="/">
  <h1 class="mb-6 text-2xl font-bold tracking-tight sm:text-3xl">
    Power system conference deadlines
  </h1>

  <FilterBar
    client:load
    tags={options.tags}
    societies={options.societies}
    regions={options.regions}
    totalCount={editions.length}
  />

  {
    editions.length === 0 && (
      <p class="mt-8 rounded-lg border border-dashed p-8 text-center text-muted-foreground">
        No conferences yet.
      </p>
    )
  }

  <div class="mt-6 space-y-8">
    {
      grouped.map((group) => (
        <section data-card-group>
          <h2 class="text-sm font-semibold tracking-wide uppercase opacity-70">{group.title}</h2>
          {group.blurb && <p class="mt-1 text-sm text-muted-foreground">{group.blurb}</p>}
          <div class="mt-3 space-y-3">
            {group.editions.map((edition) => (
              <div data-card-slot>
                <ConferenceCard edition={edition} />
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  {
    archived.length > 0 && (
      <section data-archive-matches hidden class="mt-8">
        <h2 class="text-sm font-semibold tracking-wide uppercase opacity-70">In the archive</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          Past editions matching your search. Every deadline has passed.
        </p>
        <ul class="mt-3 space-y-1.5 text-sm">
          {archived.map((edition) => (
            <li data-archive-entry hidden {...filterAttributes(edition)}>
              <a
                href={withBase(`/conference/${edition.id}`)}
                class="font-medium hover:text-primary hover:underline"
              >
                {edition.name} {edition.year}
              </a>
              <span class="text-muted-foreground">
                {' '}
                · {locationLabel(edition)} · {edition.dateLabel}
                {edition.cancelled && ' · Cancelled'}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

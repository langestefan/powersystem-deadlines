---
import type { GetStaticPaths } from 'astro';

import YearCalendar from '@/components/YearCalendar.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllEditions, type ConferenceEdition } from '@/lib/conferences';
import { yearsWithData } from '@/lib/overview';

export const getStaticPaths: GetStaticPaths = async () => {
  const editions = await getAllEditions();
  const years = yearsWithData(editions);

  return years.map((year) => ({
    params: { year: String(year) },
    props: { year, years, editions },
  }));
};

interface Props {
  year: number;
  years: number[];
  editions: ConferenceEdition[];
}

const { year, years, editions } = Astro.props;
---

<BaseLayout
  path={`/overview/${year}`}
  title={`${year} calendar`}
  description={`Every power system conference deadline and conference date in ${year}, on one page.`}
>
  <YearCalendar year={year} years={years} editions={editions} />
</BaseLayout>

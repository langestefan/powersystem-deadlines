---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { REPO_URL } from '@/lib/site';
---

<BaseLayout path="/about" title="About">
  <div class="max-w-2xl space-y-4">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">About</h1>

    <p>Free, open source and MIT licensed.</p>

    <div class="flex flex-wrap gap-2 pt-2">
      <a
        class="rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground hover:opacity-90"
        href={`${REPO_URL}/issues/new?template=new-conference.yml`}
      >
        Add a conference
      </a>
      <a
        class="rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-accent"
        href={`${REPO_URL}/blob/main/CONTRIBUTING.md`}
      >
        Contributing guide
      </a>
      <a class="rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-accent" href={REPO_URL}>
        Source
      </a>
    </div>
  </div>
</BaseLayout>

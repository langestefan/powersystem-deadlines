---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { REPO_URL } from '@/lib/site';
---

<BaseLayout path="/about" title="About">
  <div class="max-w-2xl space-y-4">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">About</h1>

    <p>
      Submission deadlines for power system conferences, in one place, with calendar feeds you
      can subscribe to.
    </p>

    <p>
      Every conference is one YAML file in the repository. Dates come from the official call for
      papers and nowhere else. Deadlines still move, so check the official site before you rely
      on a date here.
    </p>

    <p>
      Community-maintained and MIT licensed. Following
      <a class="text-primary underline underline-offset-4" href="https://aideadlin.es/">ai-deadlines</a>
      and
      <a class="text-primary underline underline-offset-4" href="https://ds-deadlines.github.io/">ds-deadlines</a>.
    </p>

    <div class="flex flex-wrap gap-2 pt-2">
      <a
        class="rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground hover:opacity-90"
        href={`${REPO_URL}/issues/new?template=new-conference.yml`}
      >
        Add a conference
      </a>
      <a
        class="rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-accent"
        href={`${REPO_URL}/blob/main/CONTRIBUTING.md`}
      >
        Contributing guide
      </a>
      <a class="rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-accent" href={REPO_URL}>
        Source
      </a>
    </div>
  </div>
</BaseLayout>

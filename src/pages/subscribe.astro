---
import SubscribeLinks from '@/components/SubscribeLinks.tsx';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllEditions, tagsInUse } from '@/lib/conferences';
import { allFeeds, feedUrl, googleSubscribeUrl, webcalUrl } from '@/lib/feeds';
import { withBase } from '@/lib/site';

const editions = await getAllEditions();
const feeds = allFeeds(tagsInUse(editions));

// The two headline feeds get the full treatment; the per-topic ones are a
// compact list, so the page does not become sixteen identical cards, and so
// only two copy-to-clipboard islands hydrate instead of eighteen.
const primary = feeds.filter((feed) => feed.kind !== 'tag');
const topicFeeds = feeds.filter((feed) => feed.kind === 'tag');

const instructions = [
  {
    app: 'Google Calendar',
    steps:
      'Use the Google Calendar button, or: Other calendars → From URL → paste the feed URL → Add calendar.',
  },
  {
    app: 'Apple Calendar',
    steps:
      'Use the Apple / Outlook button, or: File → New Calendar Subscription → paste the feed URL. Set auto-refresh to every day.',
  },
  {
    app: 'Outlook',
    steps:
      'Add calendar → Subscribe from web → paste the feed URL. The webcal:// link does the same thing in one click.',
  },
  {
    app: 'Thunderbird',
    steps: 'New Calendar → On the Network → iCalendar (ICS) → paste the feed URL.',
  },
];
---

<BaseLayout
  path="/subscribe"
  title="Subscribe"
  description="Subscribe to power system conference deadlines from Google Calendar, Apple Calendar, Outlook or any other calendar app."
>
  <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Subscribe</h1>

  <section class="mt-8 space-y-3">
    {
      primary.map((feed) => (
        <div class="rounded-lg border bg-card p-4 shadow-sm">
          <h2 class="font-semibold">{feed.label}</h2>
          <div class="mt-3">
            <SubscribeLinks
              client:visible
              httpsUrl={feedUrl(feed.path)}
              webcalUrl={webcalUrl(feed.path)}
              googleUrl={googleSubscribeUrl(feed.path)}
            />
          </div>
        </div>
      ))
    }
  </section>

  <section class="mt-10">
    <h2 class="text-lg font-semibold">By topic</h2>

    <ul class="mt-4 grid gap-x-6 sm:grid-cols-2">
      {
        topicFeeds.map((feed) => (
          <li class="flex items-center justify-between gap-3 border-b py-2.5 text-sm">
            <span class="min-w-0 truncate">{feed.label}</span>
            <span class="flex shrink-0 items-center gap-2 text-xs">
              <a class="text-muted-foreground hover:text-primary" href={webcalUrl(feed.path)}>
                Apple / Outlook
              </a>
              <a
                class="text-muted-foreground hover:text-primary"
                href={googleSubscribeUrl(feed.path)}
                rel="noopener"
              >
                Google
              </a>
              <a class="text-muted-foreground hover:text-primary" href={withBase(feed.path)}>
                .ics
              </a>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="text-lg font-semibold">How to subscribe</h2>
    <dl class="mt-3 divide-y rounded-lg border bg-card">
      {
        instructions.map((entry) => (
          <div class="grid gap-1 p-4 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="font-medium">{entry.app}</dt>
            <dd class="text-sm text-muted-foreground">{entry.steps}</dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-3 text-sm text-muted-foreground">
      Feeds ask to be re-read every 12 hours. Google can take up to a day.
    </p>
  </section>

</BaseLayout>

---
import SubscribeLinks from '@/components/SubscribeLinks.tsx';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllEditions, tagsInUse } from '@/lib/conferences';
import { allFeeds, feedUrl, googleSubscribeUrl, webcalUrl } from '@/lib/feeds';

const editions = await getAllEditions();
const feeds = allFeeds(tagsInUse(editions));

const instructions = [
  {
    app: 'Google Calendar',
    steps:
      'Use the Google Calendar button, or: Other calendars → From URL → paste the feed URL → Add calendar.',
  },
  {
    app: 'Apple Calendar',
    steps:
      'Use the Apple / Outlook button, or: File → New Calendar Subscription → paste the feed URL. Set auto-refresh to every day.',
  },
  {
    app: 'Outlook',
    steps:
      'Add calendar → Subscribe from web → paste the feed URL. The webcal:// link does the same thing in one click.',
  },
  {
    app: 'Thunderbird',
    steps: 'New Calendar → On the Network → iCalendar (ICS) → paste the feed URL.',
  },
];
---

<BaseLayout
  path="/subscribe"
  title="Subscribe"
  description="Subscribe to power system conference deadlines from Google Calendar, Apple Calendar, Outlook or any other calendar app."
>
  <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Subscribe to the deadlines</h1>
  <p class="mt-2 max-w-2xl text-muted-foreground">
    These are live calendar feeds, not one-off downloads. Subscribe once and your calendar
    updates itself whenever a deadline is added, moved or corrected here. Every deadline comes
    with reminders one week and one day ahead.
  </p>

  <section class="mt-8 space-y-3">
    {
      feeds.map((feed) => (
        <div class="rounded-lg border bg-card p-4 shadow-sm">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="min-w-0">
              <h2 class="font-semibold">{feed.name}</h2>
              <p class="mt-0.5 text-sm text-muted-foreground">{feed.description}</p>
            </div>
          </div>
          <div class="mt-3">
            <SubscribeLinks
              client:visible
              httpsUrl={feedUrl(feed.path)}
              webcalUrl={webcalUrl(feed.path)}
              googleUrl={googleSubscribeUrl(feed.path)}
            />
          </div>
        </div>
      ))
    }
  </section>

  <section class="mt-10">
    <h2 class="text-lg font-semibold">How to subscribe</h2>
    <dl class="mt-3 divide-y rounded-lg border bg-card">
      {
        instructions.map((entry) => (
          <div class="grid gap-1 p-4 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="font-medium">{entry.app}</dt>
            <dd class="text-sm text-muted-foreground">{entry.steps}</dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-3 text-sm text-muted-foreground">
      Calendar apps decide their own refresh interval. The feed asks for every 12 hours, but
      Google in particular can take up to a day to pick up a change.
    </p>
  </section>

  <section class="mt-10">
    <h2 class="text-lg font-semibold">A single conference</h2>
    <p class="mt-2 max-w-2xl text-sm text-muted-foreground">
      Every conference page has its own feed covering just that event's deadlines plus the
      conference dates themselves — useful if you only care about one venue.
    </p>
  </section>
</BaseLayout>

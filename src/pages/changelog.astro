---
import ChangelogTable from '@/components/ChangelogTable.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { changelogEntries } from '@/lib/changelog';
import { getAllEditions } from '@/lib/conferences';

const entries = changelogEntries(await getAllEditions());
---

<BaseLayout
  path="/changelog"
  title="Changelog"
  description="Every change made to a conference's dates and details, and when it was made."
>
  <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Changelog</h1>

  {
    entries.length === 0 ? (
      <p class="mt-8 rounded-lg border border-dashed p-8 text-center text-muted-foreground">
        No changes recorded yet.
      </p>
    ) : (
      <div class="mt-6 rounded-lg border bg-card px-4 py-2 shadow-sm">
        <ChangelogTable entries={entries} showConference />
      </div>
    )
  }
</BaseLayout>
